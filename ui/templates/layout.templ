package templates

import "fmt"

// Base is the HTML skeleton every page renders into. CDN dependencies are
// version-pinned; see CONTEXT.md > Static Assets. The theme is stock DaisyUI
// dark (custom theme deferred; see UI Design Direction) - the data-theme
// attribute swaps to others: dim, night, business, dracula, sunset, nord.
templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" type="image/png" href="/logo.png"/>
			<link
				href="https://cdn.jsdelivr.net/npm/daisyui@5.7.16/daisyui.css"
				rel="stylesheet"
				type="text/css"
				integrity="sha256-GQTycwr2OIyUj+ok6c+6ligubbvkG7Vcl/zwXCLEO4g="
				crossorigin="anonymous"
			/>
			<link
				href="https://cdn.jsdelivr.net/npm/daisyui@5.7.16/themes.css"
				rel="stylesheet"
				type="text/css"
				integrity="sha256-6/wrf5HWy8I5zK33PAdr/ET603UswVEZLPqnOE/+nL8="
				crossorigin="anonymous"
			/>
			<script
				src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.3.3/dist/index.global.js"
				integrity="sha256-pgx4VjCgYZaAjL555ve9tKvMj0QhpHtW8pM4/ISAXjs="
				crossorigin="anonymous"
			></script>
			<script
				src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js"
				integrity="sha256-cepnGFv6jJjDnTFxfG/OXYUjcPzf0SnbRUN3TTFFwN4="
				crossorigin="anonymous"
			></script>
			@importMap()
			@contrastFixes()
			@themeScript()
		</head>
		<body class="min-h-screen bg-base-200 text-base-content">
			{ children... }
		</body>
	</html>
}

// importMap pins the whole CodeMirror dependency closure to single URLs.
// esm.sh's `*pkg` form externalizes a package's imports so every shared dep
// resolves through this map to exactly one module instance. jsdelivr's /+esm
// cannot do this: each bundle resolves shared deps independently, and two
// instances of @codemirror/state make EditorView construction throw.
// See CONTEXT.md > Static Assets.
templ importMap() {
	<script type="importmap" nonce={ templ.GetNonce(ctx) }>
	{
		"imports": {
			"codemirror": "https://esm.sh/*codemirror@6.0.2",
			"@codemirror/lang-sql": "https://esm.sh/*@codemirror/lang-sql@6.10.0",
			"@codemirror/theme-one-dark": "https://esm.sh/*@codemirror/theme-one-dark@6.1.3",
			"@codemirror/state": "https://esm.sh/@codemirror/state@6.7.1",
			"@codemirror/view": "https://esm.sh/*@codemirror/view@6.43.8",
			"@codemirror/language": "https://esm.sh/*@codemirror/language@6.12.4",
			"@codemirror/autocomplete": "https://esm.sh/*@codemirror/autocomplete@6.20.3",
			"@codemirror/commands": "https://esm.sh/*@codemirror/commands@6.10.4",
			"@codemirror/search": "https://esm.sh/*@codemirror/search@6.7.1",
			"@codemirror/lint": "https://esm.sh/*@codemirror/lint@6.9.7",
			"@lezer/common": "https://esm.sh/@lezer/common@1.5.2",
			"@lezer/highlight": "https://esm.sh/*@lezer/highlight@1.2.3",
			"@lezer/lr": "https://esm.sh/*@lezer/lr@1.4.10",
			"crelt": "https://esm.sh/crelt@1.0.7",
			"style-mod": "https://esm.sh/style-mod@4.1.3",
			"w3c-keyname": "https://esm.sh/w3c-keyname@2.2.8",
			"sql-formatter": "https://esm.sh/sql-formatter@15.8.2"
		}
	}
	</script>
}

// Shell wraps authed pages in an app-shell layout: fixed nav, and main as the
// height-bounded content region. Normal pages scroll inside main; the logs
// page fills main exactly (h-full) and scrolls only its results pane.
templ Shell(title string, active string, csrfToken string) {
	@Base(title) {
		<div class="h-dvh flex flex-col">
			<div class="navbar bg-base-100 border-b border-base-content/10 px-2 sm:px-4 min-h-14 shrink-0">
				<div class="flex-1 flex items-center gap-2 sm:gap-8">
					// mobile: CSS-only dropdown (focus-based, closes on navigation);
					// desktop keeps the tab bar
					<div class="dropdown sm:hidden">
						<div tabindex="0" role="button" class="btn btn-ghost btn-sm btn-square" aria-label="Menu">
							<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"></path></svg>
						</div>
						<ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-30 w-44 p-2 shadow-lg border border-base-content/10">
							@menuLink("/", "Home", active == "home")
							@menuLink("/logs", "Logs", active == "logs")
							@menuLink("/metrics-explorer", "Metrics", active == "metrics")
							@menuLink("/dashboards", "Dashboards", active == "dashboards")
							@menuLink("/alerts", "Alerts", active == "alerts")
							@menuLink("/settings", "Settings", active == "settings")
						</ul>
					</div>
					<a href="/" class="flex items-center gap-2 text-lg sm:text-xl font-bold tracking-tight">
					<img src="/logo.png" alt="" class="h-6 w-auto"/>
					pooml
				</a>
					<nav class="tabs tabs-border hidden sm:flex">
						@navLink("/", "Home", active == "home")
						@navLink("/logs", "Logs", active == "logs")
						@navLink("/metrics-explorer", "Metrics", active == "metrics")
						@navLink("/dashboards", "Dashboards", active == "dashboards")
						@navLink("/alerts", "Alerts", active == "alerts")
						@navLink("/settings", "Settings", active == "settings")
					</nav>
				</div>
				<label class="swap swap-rotate btn btn-ghost btn-circle mr-1" title="Switch theme">
					<input type="checkbox" id="theme-toggle"/>
					<svg class="swap-on w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Z"></path></svg>
					<svg class="swap-off w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"></path></svg>
				</label>
				<form method="post" action="/logout">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button type="submit" class="btn btn-ghost btn-sm sm:btn-md">Log out</button>
				</form>
			</div>
			// hx-headers inherits: every HTMX request from inside main carries
			// the CSRF token (nosurf checks X-CSRF-Token for non-form requests)
			<main class="flex-1 min-h-0 overflow-y-auto p-2 sm:p-4" hx-headers={ csrfHxHeaders(csrfToken) }>
				{ children... }
			</main>
		</div>
	}
}

func csrfHxHeaders(token string) string {
	return fmt.Sprintf(`{"X-CSRF-Token": %q}`, token)
}

// contrastFixes re-anchors DaisyUI's secondary-text defaults, which mute too
// aggressively for low-contrast dark themes like dim: table headers, inactive
// tabs, and placeholders all fell below comfortable readability. One notch of
// muting maximum - see the design rule in CONTEXT.md > UI Design Direction.
templ contrastFixes() {
	<style>
		body { -webkit-font-smoothing: antialiased; font-variant-numeric: tabular-nums; }
		/* sub-16px inputs make iOS Safari zoom on focus; touch devices get 16px */
		@media (hover: none) {
			.input, .select, .textarea { font-size: 16px; }
		}
		/* one card treatment everywhere. Light: layered translucent shadows
		   read as physically raised. Dark: shadows are invisible, so the
		   stack collapses to a single quiet ring - alpha-white borders at
		   15% were the old "FOSS glow". */
		:root {
			--elevation-raised:
				0 0 0 1px rgb(0 0 0 / 0.05),
				0 1px 3px rgb(0 0 0 / 0.05),
				0 4px 10px -4px rgb(0 0 0 / 0.05);
		}
		[data-theme="dark"] {
			--elevation-raised: 0 0 0 1px rgb(255 255 255 / 0.09);
		}
		.card { box-shadow: var(--elevation-raised); }
		/* hover must move AWAY from the surface: base-content alpha lightens
		   on dark and darkens on light; DaisyUI's ghost hover goes the wrong
		   way (toward black) on dark themes */
		.btn-ghost:not(:active):hover {
			background-color: color-mix(in oklab, var(--color-base-content) 8%, transparent);
		}
		/* same wrong direction for neutral default buttons: DaisyUI mixes the
		   hover background toward black regardless of theme. Dark theme
		   lightens instead; colored buttons keep their own hover. */
		[data-theme="dark"] .btn:not(.btn-primary):not(.btn-secondary):not(.btn-accent):not(.btn-info):not(.btn-success):not(.btn-warning):not(.btn-error):not(.btn-ghost):not(.btn-link):not(:active):hover {
			background-color: color-mix(in oklab, var(--color-base-content) 12%, var(--color-base-100));
			border-color: color-mix(in oklab, var(--color-base-content) 16%, var(--color-base-100));
		}
		/* primary is a button-background token (58% indigo); as link TEXT on a
		   25% background it lands near 3:1, and whitening it only yields pale
		   periwinkle. Links in dark use the info token instead: a real light
		   blue built for dark surfaces. Hover lifts away from the surface
		   (DaisyUI's own hover goes toward black). */
		[data-theme="dark"] .link-primary {
			color: color-mix(in oklch, var(--color-info) 50%, white);
		}
		[data-theme="dark"] .link-primary:hover {
			color: color-mix(in oklch, var(--color-info) 30%, white);
		}
		.table thead th {
			color: color-mix(in oklab, var(--color-base-content) 90%, transparent);
		}
		.tabs .tab:not(.tab-active) {
			color: color-mix(in oklab, var(--color-base-content) 80%, transparent);
		}
		input::placeholder,
		textarea::placeholder {
			color: color-mix(in oklab, var(--color-base-content) 55%, transparent);
		}
		/* CodeMirror placeholders must read as hints, not typed content: the
		   cursor parks ON them at position 0, so styling is the only signal -
		   and once focused, the hint yields to the cursor entirely */
		.cm-editor .cm-placeholder {
			color: color-mix(in oklab, var(--color-base-content) 45%, transparent) !important;
			font-style: italic;
		}
		/* display, not visibility: a hidden-but-laid-out placeholder still
		   stretches the line box (italic substitute-font metrics), drawing
		   the caret off-center in the empty+focused state */
		.cm-editor.cm-focused .cm-placeholder {
			display: none;
		}
	</style>
}

// themeScript is the inline-script exception the CSP budgeted for since M3:
// applies the persisted theme before first paint (no flash) and keeps the nav
// toggle in sync. dark is the default; light is the alternative.
templ themeScript() {
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			// no DOM-snapshot history: pages with live JS state (CodeMirror)
			// restore wrong; Back re-fetches the full page instead
			htmx.config.historyCacheSize = 0;
			if (localStorage.getItem("pooml-theme") === "light") {
				document.documentElement.setAttribute("data-theme", "light");
			}
			document.addEventListener("change", (e) => {
				if (e.target && e.target.id === "theme-toggle") {
					const theme = e.target.checked ? "light" : "dark";
					// freeze transitions for the swap: otherwise every component
					// animates the theme change on its own clock - a ragged cascade
					const freeze = document.createElement("style");
					freeze.textContent = "* { transition: none !important; }";
					document.head.appendChild(freeze);
					document.documentElement.setAttribute("data-theme", theme);
					localStorage.setItem("pooml-theme", theme);
					requestAnimationFrame(() => requestAnimationFrame(() => freeze.remove()));
				}
			});
			document.addEventListener("DOMContentLoaded", () => {
				const t = document.getElementById("theme-toggle");
				if (t && localStorage.getItem("pooml-theme") === "light") t.checked = true;
			});
		})();
	</script>
}

templ menuLink(href string, label string, active bool) {
	<li><a href={ templ.SafeURL(href) } class={ templ.KV("menu-active", active) }>{ label }</a></li>
}

templ navLink(href string, label string, active bool) {
	if active {
		<a href={ templ.SafeURL(href) } class="tab tab-active text-base font-semibold">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) } class="tab text-base">{ label }</a>
	}
}
