package templates

// App-shell page: controls are fixed, #results fills the rest of the
// viewport, and only the results pane (#log-scroll) scrolls - anchored to the
// bottom so the newest logs are always on screen. See the M5 design talk.
templ LogsPage(v LogsView, csrfToken string) {
	@Shell("logs · pooml", "logs", csrfToken) {
		<div class="h-full flex flex-col gap-3 max-w-6xl mx-auto w-full">
			<form
				id="query-form"
				hx-get="/logs"
				hx-target="#results"
				hx-swap="innerHTML"
				hx-push-url="true"
				class="flex flex-col gap-2 shrink-0"
			>
				<div class="flex gap-2 items-center">
					@FTSSearchInput(v.FTS)
					<label class="flex items-center gap-1 cursor-pointer text-sm shrink-0" title="Live tail">
						<input type="checkbox" id="live-toggle" class="toggle toggle-sm toggle-success"/>
						Live
					</label>
					<button type="button" id="sql-toggle" class="btn btn-sm sm:hidden">SQL</button>
					@FTSOpToggle(v.Op, "hidden sm:flex")
				</div>
				<div id="sql-block" class="hidden sm:flex flex-col gap-2">
				<div class="flex items-center justify-between px-1">
					<span class="text-sm font-semibold opacity-80">SQL query</span>
					<span class="text-sm opacity-60 hidden sm:flex items-center gap-3">
						<button type="button" id="fmt-sql-logs" class="link link-primary" title="Format the SQL (Cmd/Ctrl+Shift+F)">format</button>
						<span>Cmd/Ctrl + Enter runs</span>
					</span>
				</div>
				<div
					id="sql-editor"
					data-q={ v.Q }
					style={ logsEditorReserve(v.Q) }
					class="border-2 border-base-content/20 rounded-field bg-base-100 overflow-hidden focus-within:border-primary transition-colors"
				></div>
				if len(v.Snippets) > 0 {
					<div class="flex items-center gap-1.5 flex-wrap">
						<span class="text-sm opacity-60">examples:</span>
						for _, s := range v.Snippets {
							<button
								type="button"
								class="btn btn-sm btn-ghost border border-base-content/15 font-normal"
								data-snippet={ s.SQL }
								title="Load into the editor (nothing runs until you hit Run)"
							>{ s.Label }</button>
						}
					</div>
				}
				<div class="flex items-center gap-2">
					<button type="submit" class="btn btn-primary btn-sm">Run</button>
					<button type="button" id="reset-query" class="btn btn-ghost btn-sm" title="Back to the default query, filters cleared">Reset</button>
				</div>
				</div>
			</form>
			<div id="results" class="flex-1 min-h-0 flex flex-col relative">
				@LogsResults(v)
			</div>
			<button
				type="button"
				id="resume-live"
				class="btn btn-primary btn-sm shadow-lg fixed bottom-8 right-8 hidden z-20"
			>&#9660; Resume live tail</button>
		</div>
		@logsScript()
	}
}

// The logs search controls, extracted so every surface that queries logs
// (the logs page, logs panel forms) offers the IDENTICAL experience - the
// parity rule, and one place for bugs to get fixed.
templ FTSSearchInput(fts string) {
	<input
		type="search"
		name="fts"
		value={ fts }
		placeholder="Search everything (FTS5 syntax welcome)"
		class="input input-bordered input-sm sm:input-md flex-1 min-w-0 font-mono"
	/>
}

templ FTSOpToggle(op string, extraClass string) {
	<div class={ "join", extraClass } title="How the search combines with the SQL below">
		if op == "or" {
			<input class="join-item btn btn-sm" type="radio" name="op" value="and" aria-label="AND"/>
			<input class="join-item btn btn-sm" type="radio" name="op" value="or" aria-label="OR" checked/>
		} else {
			<input class="join-item btn btn-sm" type="radio" name="op" value="and" aria-label="AND" checked/>
			<input class="join-item btn btn-sm" type="radio" name="op" value="or" aria-label="OR"/>
		}
	</div>
}

// LogsResults is the fragment swapped into #results on every query run.
templ LogsResults(v LogsView) {
	if v.Error != "" {
		<div role="alert" class="alert alert-error text-sm shrink-0">{ v.Error }</div>
	} else if v.IsViewer {
		@logViewer(v)
	} else {
		@genericTable(v)
	}
}

templ resultsToolbar(count int, truncated bool, v LogsView) {
	<div class="flex items-center justify-between shrink-0 pb-1">
		<span class="text-sm opacity-70">{ rowsLabel(count, truncated) }</span>
		<label class="flex items-center gap-1 cursor-pointer text-sm" title="Wrap long lines instead of truncating">
			<input type="checkbox" id="wrap-toggle" class="toggle toggle-xs"/>
			wrap
		</label>
	</div>
}

templ exportFooter(v LogsView) {
	<div class="flex justify-end gap-3 text-sm shrink-0 pt-1">
		<span class="opacity-60">export:</span>
		<a href={ templ.SafeURL(exportURL(v, "csv")) } class="link">CSV</a>
		<a href={ templ.SafeURL(exportURL(v, "json")) } class="link">JSON</a>
	</div>
}

templ logViewer(v LogsView) {
	@resultsToolbar(len(v.Rows), v.Truncated, v)
	// data-anchor: the page script keeps this pane pinned to the bottom on new
	// results. [overflow-anchor:none]: manual scroll compensation on prepends,
	// identical across browsers (Safari has no native scroll anchoring).
	<div
		id="log-scroll"
		data-anchor="bottom"
		class="flex-1 min-h-0 overflow-y-auto overflow-x-auto border border-base-content/15 rounded-box bg-base-100 [overflow-anchor:none]"
	>
		<table class="table font-mono">
			<thead class="sticky top-0 bg-base-100 z-10">
				<tr class="text-sm text-center">
					<th class="w-32">time</th>
					<th class="w-16">level</th>
					<th class="w-28 hidden sm:table-cell">service</th>
					<th>message</th>
				</tr>
			</thead>
			<tbody id="log-rows">
				@pageSentinel(v)
				for _, r := range v.Rows {
					@logRowTr(r, v.Q)
				}
				if len(v.Rows) == 0 {
					<tr><td colspan="4" class="text-center py-8 opacity-60 italic">Nothing matches. All quiet, or too quiet?</td></tr>
				}
			</tbody>
		</table>
	</div>
	@exportFooter(v)
}

// LogRowsPage answers a pagination fetch: a fresh sentinel plus one page of
// older rows, replacing the old sentinel row in place (prepend-above effect).
templ LogRowsPage(v LogsView) {
	@pageSentinel(v)
	for _, r := range v.Rows {
		@logRowTr(r, v.Q)
	}
}

templ pageSentinel(v LogsView) {
	if v.HasMore {
		// intersect with an explicit root, NOT `revealed`: revealed measures
		// against the window viewport and fires for clipped elements inside
		// overflow containers, which would eagerly chain-load all history
		<tr
			hx-get={ pageURL(v) }
			hx-trigger="intersect root:#log-scroll"
			hx-swap="outerHTML"
		>
			<td colspan="4" class="text-center py-2 opacity-40 text-sm">
				<span class="loading loading-dots loading-xs"></span> reaching further back
			</td>
		</tr>
	} else if v.AtStart {
		<tr><td colspan="4" class="text-center py-2 opacity-30 text-sm">beginning of history</td></tr>
	}
}

templ logRowTr(r LogRow, q string) {
	// color budget: hue is reserved for levels (semantic); service is a
	// monochrome outline tag - clickability comes from shape + hover, not color
	<tr class="log-row hover:bg-base-content/5 cursor-pointer" data-id={ rowID(r.ID) }>
		<td class="whitespace-nowrap opacity-80"><span data-ts={ msString(r.Ts) }>{ utcTime(r.Ts) }</span></td>
		<td class="text-center">
			if r.Level != nil {
				<button
					class={ levelClass(r.Level) }
					hx-get={ filterURL(q, "level", levelValue(r.Level)) }
					hx-target="#results"
					hx-swap="innerHTML"
				>{ levelName(r.Level) }</button>
			} else {
				<span class={ levelClass(r.Level) }>-</span>
			}
		</td>
		<td class="text-center hidden sm:table-cell">
			<button
				class={ serviceBadgeClass(r.Service) }
				data-tip={ serviceTip(r.Service) }
				hx-get={ filterURL(q, "service", r.Service) }
				hx-target="#results"
				hx-swap="innerHTML"
			><span class="truncate">{ r.Service }</span></button>
		</td>
		<td class="msg-cell max-w-xl truncate" title={ r.Message }>{ r.Message }</td>
	</tr>
}

// StreamRow is one live-tail row, appended client-side via EventSource.
templ StreamRow(r LogRow, q string) {
	@logRowTr(r, q)
}

// LogDetailRow expands beneath a clicked row; closed client-side.
templ LogDetailRow(d LogDetail) {
	<tr class="detail-row bg-base-300/40">
		<td colspan="4" class="p-3">
			<div class="flex flex-col gap-2 text-sm font-mono">
				<div class="flex gap-x-4 gap-y-1 flex-wrap">
					@logDetailMeta(d)
					<span class="js-close-detail cursor-pointer ml-auto opacity-60 hover:opacity-100">✕ close</span>
				</div>
				@logDetailPayload(d)
			</div>
		</td>
	</tr>
}

// LogDetailBlock is the same expansion for stream panels, which are flex
// columns rather than tables; closed client-side.
templ LogDetailBlock(d LogDetail) {
	<div class="stream-detail bg-base-300/40 rounded-field p-3 my-1">
		<div class="flex flex-col gap-2 text-sm font-mono">
			<div class="flex gap-x-4 gap-y-1 flex-wrap">
				@logDetailMeta(d)
				<span class="js-close-detail cursor-pointer ml-auto opacity-60 hover:opacity-100">✕ close</span>
			</div>
			@logDetailPayload(d)
		</div>
	</div>
}

// labeled label/value pairs: the old one-liner ("id 105 event ... retrek-api
// on apps-server") gave no visual anchor and never said which part was the
// host. One notch of muting on labels, weight on values, nothing stacked.
templ logDetailMeta(d LogDetail) {
	@metaPair("id", rowID(d.ID))
	<span class="whitespace-nowrap"><span class="opacity-60">event</span> <span class="font-semibold" data-ts={ msString(d.Ts) } data-ts-full>{ utcTime(d.Ts) }</span></span>
	<span class="whitespace-nowrap"><span class="opacity-60">ingested</span> <span class="font-semibold" data-ts={ msString(d.IngestedAt) } data-ts-full>{ utcTime(d.IngestedAt) }</span></span>
	@metaPair("service", d.Service)
	@metaPair("host", d.Host)
}

templ metaPair(label string, value string) {
	<span class="whitespace-nowrap"><span class="opacity-60">{ label }</span> <span class="font-semibold">{ value }</span></span>
}

templ logDetailPayload(d LogDetail) {
	<pre class="whitespace-pre-wrap break-all bg-base-100 rounded-field p-2">{ d.Raw }</pre>
	if d.Parsed != "" {
		<pre class="whitespace-pre-wrap break-all bg-base-100 rounded-field p-2 opacity-80">{ d.Parsed }</pre>
	}
}

// LogDetailPage is the same detail as a standalone page: reached by direct
// navigation (stream panels, shared links) rather than the logs page's
// inline HTMX expansion.
templ LogDetailPage(d LogDetail, csrfToken string) {
	@Shell("log "+rowID(d.ID)+" · pooml", "logs", csrfToken) {
		<div class="max-w-4xl mx-auto flex flex-col gap-3">
			<div>
				<a href="/logs" class="btn btn-ghost btn-sm">← logs</a>
			</div>
			<div class="card bg-base-100">
				<div class="card-body py-4">
					<div class="flex flex-col gap-2 text-sm font-mono">
						<div class="flex gap-x-4 gap-y-1 flex-wrap">
							@logDetailMeta(d)
						</div>
						@logDetailPayload(d)
					</div>
				</div>
			</div>
		</div>
		<script nonce={ templ.GetNonce(ctx) }>
			document.querySelectorAll("[data-ts]").forEach((el) => {
				el.textContent = new Date(Number(el.dataset.ts)).toLocaleString(undefined, { hour12: false });
			});
		</script>
	}
}

templ genericTable(v LogsView) {
	@resultsToolbar(len(v.Cells), v.Truncated, v)
	<div id="log-scroll" class="flex-1 min-h-0 overflow-y-auto overflow-x-auto border border-base-content/15 rounded-box bg-base-100">
		<table class="table font-mono">
			<thead class="sticky top-0 bg-base-100 z-10">
				<tr class="text-sm text-center">
					for _, c := range v.Columns {
						<th>{ c }</th>
					}
				</tr>
			</thead>
			<tbody>
				for _, row := range v.Cells {
					<tr>
						for _, cell := range row {
							<td class="msg-cell max-w-md truncate" title={ cell }>{ cell }</td>
						}
					</tr>
				}
				if len(v.Cells) == 0 {
					<tr><td colspan="99" class="text-center py-8 opacity-60 italic">Zero rows. The query ran fine; there's just nothing there.</td></tr>
				}
			</tbody>
		</table>
	</div>
	@exportFooter(v)
}

// logsScript wires CodeMirror and the page behaviors. Static content only:
// dynamic state travels via data attributes and HX-Trigger events.
// CodeMirror versions are pinned in the layout's import map.
templ logsScript() {
	<style>
		#sql-editor .cm-content { font-size: 15px; }
		#sql-editor .cm-gutters { font-size: 12px; }
		/* container reserves the mounted height so the page doesn't jump when
		   CodeMirror loads: 4rem total = cm-editor min + the 2x2px border */
		#sql-editor { min-height: 4rem; }
		#sql-editor .cm-editor { max-height: 10rem; min-height: calc(4rem - 4px); }
		/* clickable badges light up on hover so filtering reads as intended */
		.log-row button.badge:hover {
			filter: brightness(1.2);
			box-shadow: 0 0 0 1px currentColor;
		}
		/* wrap mode: #results survives fragment swaps, so the class sticks */
		#results.wrap-lines .msg-cell {
			white-space: normal;
			overflow-wrap: anywhere;
			max-width: none;
			overflow: visible;
			text-overflow: clip;
		}
		/* same focus treatment as daisy inputs, so the editor reads as a field */
		/* cause-and-effect: pulses when a quick filter rewrites the query */
		#sql-editor.query-updated {
			border-color: var(--color-primary);
			box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-primary) 40%, transparent);
		}
		#sql-editor:focus-within {
			outline: 2px solid var(--color-primary);
			outline-offset: 2px;
			border-color: var(--color-primary);
		}
	</style>
	// Paint-affecting view setup runs as a CLASSIC script, synchronously
	// during parse: time formatting, wrap mode, and bottom-anchoring must not
	// wait for the CodeMirror module fetch below, or the table visibly
	// reflows once the network catches up (the "jump on load", round two).
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			// compact local times in rows (full timestamp on hover); detail
			// rows marked data-ts-full keep the complete local timestamp
			function fmtTimes() {
				document.querySelectorAll("[data-ts]:not([data-ts-done])").forEach((el) => {
					el.dataset.tsDone = "1";
					const t = new Date(Number(el.dataset.ts));
					if (el.hasAttribute("data-ts-full")) {
						el.textContent = t.toLocaleString(undefined, { hour12: false });
					} else {
						el.textContent = t.toLocaleTimeString(undefined, { hour12: false })
							+ "." + String(t.getMilliseconds()).padStart(3, "0");
					}
					el.title = t.toLocaleString(undefined, { hour12: false });
				});
			}

			const pane = () => document.getElementById("log-scroll");
			function anchorBottom() {
				const p = pane();
				if (p && p.dataset.anchor === "bottom") p.scrollTop = p.scrollHeight;
			}

			const wrapKey = "pooml-wrap";
			function applyWrap() {
				const on = localStorage.getItem(wrapKey) !== "0"; // ON by default
				document.getElementById("results").classList.toggle("wrap-lines", on);
				const cb = document.getElementById("wrap-toggle");
				if (cb) cb.checked = on;
			}
			document.body.addEventListener("change", (e) => {
				if (e.target && e.target.id === "wrap-toggle") {
					localStorage.setItem(wrapKey, e.target.checked ? "1" : "0");
					applyWrap();
				}
			});

			window.poomlView = { fmtTimes, applyWrap, anchorBottom, pane };
			fmtTimes();
			applyWrap();
			anchorBottom();
		})();
	</script>
	<script type="module" nonce={ templ.GetNonce(ctx) }>
		import { EditorView, basicSetup } from "codemirror";
		import { placeholder, keymap } from "@codemirror/view";
		import { Compartment, Prec } from "@codemirror/state";
		import { acceptCompletion } from "@codemirror/autocomplete";
		import { SQLite, schemaCompletionSource } from "@codemirror/lang-sql";
		import { LanguageSupport, syntaxTree } from "@codemirror/language";
		import { linter, setDiagnostics } from "@codemirror/lint";
		import { oneDark } from "@codemirror/theme-one-dark";
		import { format } from "sql-formatter";

		const { fmtTimes, applyWrap, anchorBottom, pane } = window.poomlView;

		// formatting survives until the next Run: the server canonicalizes q
		// through the serializer when merging filters/FTS (see CONTEXT.md)
		function fmtDoc(v) {
			try {
				const pretty = format(v.state.doc.toString(), { language: "sqlite", keywordCase: "upper" });
				if (pretty !== v.state.doc.toString()) {
					v.dispatch({ changes: { from: 0, to: v.state.doc.length, insert: pretty } });
				}
			} catch (e) { /* unparseable mid-edit SQL: leave it alone */ }
			return true;
		}

		const host = document.getElementById("sql-editor");

		// Completions are composed by hand instead of using sql()'s bundle:
		// the dialect keyword source suggests the whole SQL-standard word list
		// (SYSTEM_USER and friends - not even SQLite), drowning the schema.
		// Here: columns first (defaultTable makes them top-level), then a
		// curated keyword/function list that is actually true for pooml.
		// logs_fts deliberately absent: the search bar is the FTS path.
		const LOGS_COLUMNS = ["id", "timestamp", "ingested_at", "level", "service", "host", "message", "parsed", "raw"];
		const schemaSource = schemaCompletionSource({
			dialect: SQLite,
			schema: { logs: LOGS_COLUMNS },
			defaultTable: "logs",
			upperCaseKeywords: true,
		});
		const KEYWORDS = ("SELECT FROM WHERE AND OR NOT ORDER BY GROUP HAVING LIMIT OFFSET DESC ASC " +
			"IN LIKE MATCH BETWEEN IS NULL DISTINCT AS JOIN ON CASE WHEN THEN ELSE END CAST")
			.split(" ").map((k) => ({ label: k, type: "keyword", boost: -1 }));
		const FUNCTIONS = ("count sum avg min max unixepoch strftime datetime json_extract length coalesce round")
			.split(" ").map((f) => ({ label: f, type: "function", boost: -2 }));
		const KEYWORD_OPTIONS = KEYWORDS.concat(FUNCTIONS);
		function keywordSource(ctx) {
			if (complCtx(ctx) !== "general") return null;
			const w = ctx.matchBefore(/[A-Za-z_]+/);
			if (!w && !ctx.explicit) return null;
			return { from: w ? w.from : ctx.pos, options: KEYWORD_OPTIONS, validFor: /^[A-Za-z_]*$/ };
		}
		// completion context gating: after FROM/JOIN only table names make
		// sense; after a dot the schema source's column completion owns it
		const TABLES = [{ label: "logs", type: "type" }];
		const tablePosRe = /\b(from|join)\s+[\w"]*$/i;
		const dotPosRe = /\.\w*$/;
		function complCtx(ctx) {
			const before = ctx.state.sliceDoc(Math.max(0, ctx.pos - 40), ctx.pos);
			if (tablePosRe.test(before)) return "table";
			if (dotPosRe.test(before)) return "dot";
			return "general";
		}
		function tableSource(ctx) {
			if (complCtx(ctx) !== "table") return null;
			const w = ctx.matchBefore(/[\w"]+/);
			if (!w && !ctx.explicit) return null;
			return { from: w ? w.from : ctx.pos, options: TABLES, validFor: /^[\w"]*$/ };
		}
		const gatedSchema = (ctx) => complCtx(ctx) === "table" ? null : schemaSource(ctx);
		const sqlSupport = new LanguageSupport(SQLite.language, [
			SQLite.language.data.of({ autocomplete: tableSource }),
			SQLite.language.data.of({ autocomplete: gatedSchema }),
			SQLite.language.data.of({ autocomplete: keywordSource }),
		]);

		// live squiggles from the lezer parse: generic but instant. The
		// authoritative check stays server-side (rqlite parser).
		const syntaxLinter = linter((v) => {
			if (!v.state.doc.length) return [];
			const diags = [];
			syntaxTree(v.state).iterate({
				enter: (n) => {
					if (n.type.isError) {
						diags.push({ from: n.from, to: Math.max(n.to, n.from + 1), severity: "error", message: "syntax error" });
					}
				},
			});
			return diags;
		});

		// theme lives in a compartment so the nav toggle can swap it live;
		// light mode uses CodeMirror's default (light) look
		const editorTheme = new Compartment();
		const isLight = () => document.documentElement.getAttribute("data-theme") === "light";
		const view = new EditorView({
			doc: host.dataset.q,
			extensions: [
				Prec.highest(keymap.of([
					{ key: "Tab", run: acceptCompletion },
					{ key: "Enter", run: acceptCompletion },
					{ key: "Mod-Shift-f", run: fmtDoc },
				])),
				basicSetup,
				editorTheme.of(isLight() ? [] : oneDark),
				placeholder("SELECT * FROM logs ORDER BY timestamp DESC LIMIT 100"),
				sqlSupport,
				syntaxLinter,
			],
			parent: host,
		});

		// server-rejected SQL comes back with an exact position; underline it
		document.body.addEventListener("sqlError", (e) => {
			const d = e.detail;
			let from = 0;
			try {
				const l = view.state.doc.line(d.line);
				from = Math.min(l.from + Math.max(d.col - 1, 0), l.to);
			} catch { /* stale position; underline from the start */ }
			view.dispatch(setDiagnostics(view.state, [{ from, to: from, severity: "error", message: d.message }]));
		});

		const form = document.getElementById("query-form");
		form.addEventListener("htmx:configRequest", (e) => {
			e.detail.parameters.q = view.state.doc.toString();
		});
		host.addEventListener("keydown", (e) => {
			if ((e.metaKey || e.ctrlKey) && e.key === "Enter") {
				e.preventDefault();
				form.requestSubmit();
			}
		}, true);
		document.body.addEventListener("setQuery", (e) => {
			view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: e.detail.q } });
			host.classList.add("query-updated");
			setTimeout(() => host.classList.remove("query-updated"), 800);
		});

		// prepends shift content down; compensate manually so the viewport
		// stays put (native scroll anchoring is off - Safari doesn't have it)
		let heightBefore = 0;
		document.body.addEventListener("htmx:beforeRequest", (e) => {
			const p = pane();
			heightBefore = p && e.detail.elt.closest("#log-scroll") ? p.scrollHeight : 0;
		});
		document.body.addEventListener("htmx:afterSettle", (e) => {
			fmtTimes();
			applyWrap();
			const p = pane();
			if (!p) return;
			if (e.detail.target && e.detail.target.id === "results") {
				anchorBottom();
				if (liveWanted) startLive();
			} else if (heightBefore > 0) {
				p.scrollTop += p.scrollHeight - heightBefore;
				heightBefore = 0;
			}
		});

		new MutationObserver(() => {
			view.dispatch({ effects: editorTheme.reconfigure(isLight() ? [] : oneDark) });
		}).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

		// snippet chips load their SQL into the editor - never run it
		document.addEventListener("click", (e) => {
			const chip = e.target.closest("[data-snippet]");
			if (!chip) return;
			view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: chip.dataset.snippet } });
			view.focus();
		});

		const fmtBtn = document.getElementById("fmt-sql-logs");
		if (fmtBtn) fmtBtn.addEventListener("click", () => fmtDoc(view));

		// re-anchor once the editor is mounted: the reserved min-height keeps
		// this a no-op unless the line estimate was slightly off
		anchorBottom();

		const DEFAULT_Q = "SELECT * FROM logs ORDER BY timestamp DESC LIMIT 100";
		document.getElementById("sql-toggle").addEventListener("click", () => {
			const block = document.getElementById("sql-block");
			block.classList.toggle("hidden");
			block.classList.toggle("flex");
		});

		document.getElementById("reset-query").addEventListener("click", () => {
			view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: DEFAULT_Q } });
			form.elements.fts.value = "";
			const andRadio = form.querySelector('input[name="op"][value="and"]');
			if (andRadio) andRadio.checked = true;
			form.requestSubmit();
		});

		// --- live tail (SSE via EventSource; see CONTEXT.md > Streaming) ---
		const liveToggle = document.getElementById("live-toggle");
		const resumeBtn = document.getElementById("resume-live");
		let es = null;
		let liveWanted = false;

		function startLive() {
			stopLive();
			const params = new URLSearchParams({ q: view.state.doc.toString() });
			const fts = form.elements.fts.value.trim();
			if (fts) {
				params.set("fts", fts);
				params.set("op", new FormData(form).get("op") || "and");
			}
			es = new EventSource("/logs/stream?" + params.toString());
			es.addEventListener("log", (e) => {
				const tbody = document.getElementById("log-rows");
				if (!tbody) return;
				tbody.insertAdjacentHTML("beforeend", e.data);
				while (tbody.children.length > 5000) tbody.removeChild(tbody.firstElementChild);
				fmtTimes();
				anchorBottom();
			});
			es.addEventListener("refresh", (e) => {
				document.getElementById("results").innerHTML = e.data;
				fmtTimes();
				applyWrap();
			});
			es.addEventListener("streamerror", (e) => {
				stopLive();
				liveToggle.checked = false;
				liveWanted = false;
				console.warn("live tail: " + e.data);
			});
		}
		function stopLive() {
			if (es) { es.close(); es = null; }
		}
		function showResume(on) {
			resumeBtn.classList.toggle("hidden", !on);
		}

		if (new URLSearchParams(location.search).get("live") === "1") {
			liveToggle.checked = true;
			liveWanted = true;
			startLive();
		}

		// live is URL state (triage links already open ?live=1): keep the
		// param in sync so refresh restores the stream. replaceState, not
		// push - toggling must not mint history entries.
		function syncLiveURL() {
			const u = new URL(location);
			if (liveWanted) u.searchParams.set("live", "1");
			else u.searchParams.delete("live");
			history.replaceState(history.state, "", u);
		}
		// query runs push URLs built from form fields, which drop live=1
		document.body.addEventListener("htmx:pushedIntoHistory", syncLiveURL);

		liveToggle.addEventListener("change", () => {
			liveWanted = liveToggle.checked;
			showResume(false);
			if (liveWanted) { startLive(); anchorBottom(); } else { stopLive(); }
			syncLiveURL();
		});

		// scroll-up stops the stream outright - toggle off, honest state;
		// the floating button is a shortcut to re-enable from down there
		document.getElementById("results").addEventListener("scroll", (e) => {
			const p = e.target;
			if (!liveWanted || !es || !p.dataset || p.dataset.anchor !== "bottom") return;
			const nearBottom = p.scrollHeight - p.scrollTop - p.clientHeight < 40;
			if (!nearBottom) {
				stopLive();
				liveWanted = false;
				liveToggle.checked = false;
				showResume(true);
			}
		}, true);

		resumeBtn.addEventListener("click", () => {
			showResume(false);
			liveWanted = true;
			liveToggle.checked = true;
			// fresh snapshot covers the gap, then afterSettle reconnects
			form.requestSubmit();
		});

		document.getElementById("results").addEventListener("click", (e) => {
			const closer = e.target.closest(".js-close-detail");
			if (closer) { closer.closest("tr").remove(); return; }
			if (e.target.closest("button, a")) return;
			const tr = e.target.closest("tr.log-row");
			if (!tr || !tr.dataset.id || tr.dataset.id === "0") return;
			const next = tr.nextElementSibling;
			if (next && next.classList.contains("detail-row")) { next.remove(); return; }
			htmx.ajax("GET", "/logs/" + tr.dataset.id, { target: tr, swap: "afterend" });
		});
	</script>
}
