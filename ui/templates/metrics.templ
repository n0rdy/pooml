package templates

import (
	"strconv"

	"github.com/n0rdy/pooml/services"
)

type MetricsExplorerView struct {
	Query   string
	View    string // auto | line | bar | stat | table
	DSL     string // last DSL input; SQL stays canonical
	Shaped  ShapedResult
	SaveErr string

	// catalog names feeding the DSL autocomplete
	MetricNames []string

	// empty-result disambiguation: nothing ingested vs nothing matched
	HasAnyMetrics bool
	// save-as-panel targets; empty = offer creating a dashboard first
	Dashboards []services.Dashboard
	// clickable examples of the hard patterns, prefilled from the catalog
	Snippets []QuerySnippet
}

type QuerySnippet struct {
	Label string
	SQL   string
	// authored DSL equivalent where one exists (never decompiled from SQL);
	// chips carrying one teach the DSL by filling both layers
	DSL string
}

templ MetricsExplorerPage(v MetricsExplorerView, csrfToken string) {
	@Shell("metrics · pooml", "metrics", csrfToken) {
		<div class="max-w-6xl mx-auto flex flex-col gap-4">
			<div class="card bg-base-100">
				<div class="card-body py-4 gap-2">
					<form method="get" action="/metrics-explorer" class="flex flex-col gap-2">
						<div class="flex flex-col gap-1">
							<span class="flex items-center gap-2">
								<span class="text-sm opacity-80">Quick query</span>
								<span class="join">
									<button type="button" id="dsl-mode-builder" class="join-item btn btn-sm">builder</button>
									<button type="button" id="dsl-mode-text" class="join-item btn btn-sm">text</button>
								</span>
							</span>
							<div id="dsl-builder" class="hidden flex-col gap-2 border-2 border-base-content/20 rounded-field bg-base-100 p-2">
								<div class="flex items-end gap-2 flex-wrap">
									<label class="flex flex-col gap-1">
										<span class="text-sm opacity-60">verb</span>
										<select id="b-verb" class="select select-bordered select-sm">
											<option>avg</option>
											<option>increase</option>
											<option>rate</option>
											<option>min</option>
											<option>max</option>
											<option>sum</option>
											<option>count</option>
											<option>latest</option>
										</select>
									</label>
									<label class="flex flex-col gap-1">
										<span class="text-sm opacity-60">metric</span>
										<input id="b-metric" list="metric-names-dl" class="input input-bordered input-sm w-64" placeholder="pick or type"/>
									</label>
								</div>
								<div class="flex items-end gap-2 flex-wrap">
									<div id="b-filters" class="contents"></div>
									<button type="button" id="b-add-filter" class="btn btn-ghost btn-sm mb-1" title="Add a key=value filter (service and host are columns; anything else matches labels)">+ filter</button>
								</div>
								<div class="flex items-end gap-2 flex-wrap">
									<label class="flex flex-col gap-1">
										<span class="text-sm opacity-60">per</span>
										<select id="b-per" class="select select-bordered select-sm w-20">
											<option value="">off</option>
											<option>1m</option>
											<option>5m</option>
											<option>10m</option>
											<option>30m</option>
											<option>1h</option>
											<option>1d</option>
										</select>
									</label>
									<label class="flex flex-col gap-1">
										<span class="text-sm opacity-60">last</span>
										<select id="b-last" class="select select-bordered select-sm w-22">
											<option>15m</option>
											<option>1h</option>
											<option>6h</option>
											<option selected>24h</option>
											<option>7d</option>
											<option>30d</option>
										</select>
									</label>
									<label class="flex items-center gap-2 text-sm mb-1 cursor-pointer">
										<input type="checkbox" id="b-by-service" class="checkbox checkbox-sm"/>
										by service
									</label>
								</div>
								<div id="b-dsl-preview" class="text-sm font-mono opacity-60"></div>
							</div>
							<div
								id="dsl-input"
								data-dsl={ v.DSL }
								class="border-2 border-base-content/20 rounded-field bg-base-100 overflow-hidden transition-colors"
								style="min-height: 45px"
							></div>
							<div id="dsl-hint" class="text-sm text-error hidden"></div>
							<div id="dsl-counter-hint" class="text-sm text-warning hidden"></div>
						</div>
						<datalist id="metric-names-dl">
							for _, n := range v.MetricNames {
								<option value={ n }></option>
							}
						</datalist>
						<datalist id="b-fkeys-dl"></datalist>
						<datalist id="b-fvals-dl"></datalist>
						<input type="hidden" name="dsl" value={ v.DSL }/>
						<span class="flex items-center justify-between">
							<span class="text-sm opacity-80">SQL over <code class="font-mono">metrics</code> <span class="opacity-60">- the quick query compiles here; edit it and it's yours</span></span>
							<span class="text-sm opacity-60 flex items-center gap-3">
								<button type="button" class="fmt-sql link link-primary" title="Format the SQL (Cmd/Ctrl+Shift+F)">format</button>
								Cmd/Ctrl+Enter runs
							</span>
						</span>
						<textarea name="q" class="hidden">{ v.Query }</textarea>
						<div
							class="sql-editor-host border-2 border-base-content/20 rounded-field bg-base-100 overflow-hidden transition-colors"
							style={ sqlEditorReserve(v.Query) }
							data-placeholder="SELECT name, service, value, timestamp FROM metrics ORDER BY timestamp DESC LIMIT 100"
						></div>
						<input type="hidden" name="view" value={ v.View }/>
						if len(v.Snippets) > 0 {
							<div class="flex items-center gap-1.5 flex-wrap">
								<span class="text-sm opacity-60">examples:</span>
								for _, s := range v.Snippets {
									<button
										type="button"
										class="btn btn-sm btn-ghost border border-base-content/15 font-normal"
										data-snippet={ s.SQL }
										data-dsl-snippet={ s.DSL }
										title="Load into the editor (nothing runs until you hit Run)"
									>{ s.Label }</button>
								}
							</div>
						}
						<div class="flex items-center gap-2">
							<button type="submit" class="btn btn-primary btn-sm">Run</button>
							<a href="/metrics-explorer" class="btn btn-ghost btn-sm">Reset</a>
						</div>
					</form>
				</div>
			</div>
			if v.SaveErr != "" {
				<div role="alert" class="alert alert-error text-sm">Saving the panel failed: { v.SaveErr }</div>
			}
			switch v.Shaped.Kind {
				case "error":
					<div role="alert" class="alert alert-error text-sm">{ v.Shaped.ErrMsg }</div>
				case "empty":
					<div class="card bg-base-100">
						<div class="card-body py-4">
							if v.HasAnyMetrics {
								<p class="text-sm opacity-60 italic">No rows matched this query. Loosen the WHERE, widen the time range.</p>
							} else {
								<p class="text-sm opacity-70">Nothing in <code class="font-mono">metrics</code> yet. Two ways in, equally good:</p>
								<ul class="text-sm opacity-70 list-disc ml-5 flex flex-col gap-1 mt-1">
									<li><b>Pull</b>: add a Prometheus scrape target in <a href="/settings" class="link link-primary">Settings</a>.</li>
									<li><b>Push</b>: send OTLP/HTTP to <code class="font-mono">POST /api/v1/otlp/v1/metrics</code> with an <code class="font-mono">X-API-Key</code> header.</li>
								</ul>
							}
						</div>
					</div>
				default:
					<div class="card bg-base-100">
						<div class="card-body py-3 gap-2">
							// the view switcher lives with the result it controls:
							// "I want this as a table" happens while looking at the chart
							<div class="flex items-center gap-3 flex-wrap">
								<span class="text-sm opacity-60 whitespace-nowrap">{ strconv.Itoa(len(v.Shaped.Rows)) } rows</span>
								<div class="join">
									@viewSegment(v, "auto", autoViewLabel(v))
									@viewSegment(v, "line", "line")
									@viewSegment(v, "bar", "bar")
									@viewSegment(v, "stat", "stat")
									@viewSegment(v, "table", "table")
								</div>
								<span class="ml-auto flex gap-3 text-sm opacity-60">
									<a href={ templ.SafeURL(metricsExportURL(v.Query, "csv")) } class="link link-hover">CSV</a>
									<a href={ templ.SafeURL(metricsExportURL(v.Query, "json")) } class="link link-hover">JSON</a>
								</span>
							</div>
							if v.Shaped.Kind == "chart" {
								<div class="h-72 relative">
									<canvas data-chart={ v.Shaped.ChartID }></canvas>
								</div>
								@templ.JSONScript("chart-data-"+v.Shaped.ChartID, v.Shaped.Chart)
								<details class="mt-1">
									<summary class="cursor-pointer text-sm opacity-60">rows ({ strconv.Itoa(len(v.Shaped.Rows)) })</summary>
									@shapedTable(v.Shaped, "max-h-72")
								</details>
							} else {
								@Shaped(v.Shaped)
							}
						</div>
					</div>
					@saveAsPanel(v, csrfToken)
			}
		</div>
		@templ.JSONScript("metric-names", v.MetricNames)
		@sqlEditorModule()
		@chartScripts()
		@dslScript()
	}
}

// dslScript mounts the one-line DSL editor: autocomplete (verbs by position,
// catalog metric names inside the parens, durations after per/last), a
// debounced compile fetch mirroring into the SQL editor, and
// detach-by-clearing when the SQL is hand-edited (the placeholder swap is
// the explanation). Enter runs; the hidden dsl input keeps the URL honest.
templ dslScript() {
	<style>
		/* symmetric padding centers the single line; a forced min-height
		   left the slack below the text and the cursor riding high */
		#dsl-input .cm-content { font-size: 15px; padding: 10px 0; }
		#dsl-input:focus-within {
			outline: 2px solid var(--color-primary);
			outline-offset: 2px;
			border-color: var(--color-primary);
		}
	</style>
	<script type="module">
		import { EditorView, keymap, placeholder } from "@codemirror/view";
		import { EditorState, Compartment, Prec } from "@codemirror/state";
		import { autocompletion, acceptCompletion } from "@codemirror/autocomplete";
		import { oneDark } from "@codemirror/theme-one-dark";

		const host = document.getElementById("dsl-input");
		if (host) {
			const form = host.closest("form");
			const hidden = form.querySelector('input[name="dsl"]');
			const hint = document.getElementById("dsl-hint");
			const counterHint = document.getElementById("dsl-counter-hint");
			const names = JSON.parse(document.getElementById("metric-names")?.textContent || "[]") || [];
			const VERBS = ["increase", "rate", "avg", "min", "max", "sum", "count", "latest"];
			const DURS = ["1m", "5m", "10m", "30m", "1h", "6h", "24h", "7d"];

			function dslCompletion(ctx) {
				const before = ctx.state.sliceDoc(0, ctx.pos);
				const open = before.lastIndexOf("(");
				const close = before.lastIndexOf(")");
				if (open > close) {
					const w = ctx.matchBefore(/[^()\s]*/);
					if (!names.length) return null;
					return { from: w ? w.from : ctx.pos, options: names.map((n) => ({ label: n, type: "constant" })), validFor: /^[^()\s]*$/ };
				}
				if (open === -1) {
					const w = ctx.matchBefore(/\w*/);
					if (!w && !ctx.explicit) return null;
					return { from: w ? w.from : ctx.pos, options: VERBS.map((v) => ({ label: v, apply: v + "(", type: "function" })), validFor: /^\w*$/ };
				}
				const w = ctx.matchBefore(/[\w]*/);
				if (/(per|last)\s+\w*$/i.test(before)) {
					return { from: w ? w.from : ctx.pos, options: DURS.map((d) => ({ label: d, type: "constant" })), validFor: /^\w*$/ };
				}
				return {
					from: w ? w.from : ctx.pos,
					options: [
						{ label: "per", apply: "per ", type: "keyword" },
						{ label: "last", apply: "last ", type: "keyword" },
						{ label: "by service", type: "keyword" },
						{ label: "service=", type: "keyword" },
						{ label: "host=", type: "keyword" },
					],
					validFor: /^\w*$/,
				};
			}

			const isLight = () => document.documentElement.getAttribute("data-theme") === "light";
			const themeComp = new Compartment();
			const placeholderComp = new Compartment();
			const NORMAL_PH = "avg(queue_depth) per 10m last 6h by service";
			const DETACHED_PH = "custom SQL below - type here to start over";

			let compileTimer = null;
			let populateBuilderNext = false;

			const sqlView = () => {
				const h = form.querySelector(".sql-editor-host");
				return h && window.poomlSQL ? window.poomlSQL.editors.get(h) : null;
			};

			function compile() {
				const text = view.state.doc.toString().trim();
				hidden.value = text;
				if (!text) {
					hint.classList.add("hidden");
					return;
				}
				fetch("/metrics-explorer/compile?dsl=" + encodeURIComponent(text))
					.then((r) => r.json())
					.then((res) => {
						if (res.error) {
							hint.textContent = res.error;
							hint.classList.remove("hidden");
							counterHint.classList.add("hidden");
							return;
						}
						hint.classList.add("hidden");
						// advisory, not an error: e.g. avg() pointed at a counter
						counterHint.textContent = res.hint || "";
						counterHint.classList.toggle("hidden", !res.hint);
						const sv = sqlView();
						if (sv && res.sql !== sv.state.doc.toString()) {
							sv.dispatch({ changes: { from: 0, to: sv.state.doc.length, insert: res.sql } });
						}
						// one-shot: builder catches up after a chip click, but
						// never mid-typing (it would fight the cursor)
						if (populateBuilderNext && res.parsed) {
							populateBuilder(res.parsed);
							populateBuilderNext = false;
						}
					})
					.catch(() => {});
			}

			const view = new EditorView({
				doc: host.dataset.dsl || "",
				extensions: [
					Prec.highest(keymap.of([
						{ key: "Tab", run: acceptCompletion },
						{ key: "Enter", run: (v) => acceptCompletion(v) || (form.requestSubmit(), true) },
					])),
					autocompletion({ override: [dslCompletion] }),
					placeholderComp.of(placeholder(NORMAL_PH)),
					themeComp.of(isLight() ? [] : oneDark),
					// one line, always: pasted newlines have nowhere to live here
					EditorState.transactionFilter.of((tr) => (tr.newDoc.lines > 1 ? [] : tr)),
					EditorView.updateListener.of((u) => {
						if (!u.docChanged) return;
						clearTimeout(compileTimer);
						compileTimer = setTimeout(compile, 250);
					}),
				],
				parent: host,
			});

			// --- query builder: a visual editor for the DSL string. Controls
			// generate the text, the text feeds the same compile pipeline; the
			// parsed structure comes back from the server (no grammar in JS).
			const builder = document.getElementById("dsl-builder");
			const bVerb = document.getElementById("b-verb");
			const bMetric = document.getElementById("b-metric");
			const bFilters = document.getElementById("b-filters");
			const bPer = document.getElementById("b-per");
			const bLast = document.getElementById("b-last");
			const bByService = document.getElementById("b-by-service");
			const bPreview = document.getElementById("b-dsl-preview");
			const modeBuilder = document.getElementById("dsl-mode-builder");
			const modeText = document.getElementById("dsl-mode-text");
			const MODE_KEY = "pooml-dsl-mode";

			function fmtDur(ms) {
				if (ms % 86400000 === 0) return (ms / 86400000) + "d";
				if (ms % 3600000 === 0) return (ms / 3600000) + "h";
				return (ms / 60000) + "m";
			}
			function ensureOption(sel, val) {
				if (!val) return;
				if (![...sel.options].some((o) => o.value === val || o.text === val)) {
					const o = document.createElement("option");
					o.text = val;
					sel.add(o);
				}
				sel.value = val;
			}
			function addFilterRow(key, val) {
				const row = document.createElement("label");
				row.className = "flex flex-col gap-1 b-filter";
				row.innerHTML = '<span class="text-sm opacity-60">filter</span>' +
					'<span class="join">' +
					'<input class="b-fkey join-item input input-bordered input-sm w-24" placeholder="key" list="b-fkeys-dl"/>' +
					'<input class="b-fval join-item input input-bordered input-sm w-24" placeholder="value" list="b-fvals-dl"/>' +
					'<button type="button" class="b-fremove join-item btn btn-sm btn-ghost" title="remove">✕</button>' +
					'</span>';
				row.querySelector(".b-fkey").value = key || "";
				row.querySelector(".b-fval").value = val || "";
				bFilters.appendChild(row);
			}

			// filter datalists offer what actually exists for the chosen
			// metric: keys on key-focus, values (for that row's key) on
			// value-focus. Cached per metric; a menu, not a guess.
			const fkeysDl = document.getElementById("b-fkeys-dl");
			const fvalsDl = document.getElementById("b-fvals-dl");
			const optionsCache = new Map();
			function fillDatalist(dl, options) {
				dl.innerHTML = "";
				(options || []).forEach((o) => {
					const opt = document.createElement("option");
					opt.value = o;
					dl.appendChild(opt);
				});
			}
			function fetchOptions(metric, key) {
				const cacheKey = metric + " " + (key || "");
				if (optionsCache.has(cacheKey)) return Promise.resolve(optionsCache.get(cacheKey));
				let u = "/metrics-explorer/filter-options?metric=" + encodeURIComponent(metric);
				if (key) u += "&key=" + encodeURIComponent(key);
				return fetch(u)
					.then((r) => r.json())
					.then((res) => {
						optionsCache.set(cacheKey, res.options || []);
						return res.options || [];
					})
					.catch(() => []);
			}
			bFilters.addEventListener("focusin", (e) => {
				const metric = bMetric.value.trim();
				if (!metric) return;
				if (e.target.classList.contains("b-fkey")) {
					fetchOptions(metric, "").then((o) => fillDatalist(fkeysDl, o));
				} else if (e.target.classList.contains("b-fval")) {
					const key = e.target.closest(".b-filter").querySelector(".b-fkey").value.trim();
					if (key) fetchOptions(metric, key).then((o) => fillDatalist(fvalsDl, o));
				}
			});
			function buildDSLText() {
				const metric = bMetric.value.trim();
				if (!metric) return "";
				let t = bVerb.value + "(" + metric + ")";
				bFilters.querySelectorAll(".b-filter").forEach((row) => {
					const k = row.querySelector(".b-fkey").value.trim();
					const val = row.querySelector(".b-fval").value.trim();
					if (k && val) t += " " + k + "=" + val;
				});
				if (bPer.value && bVerb.value !== "latest") t += " per " + bPer.value;
				t += " last " + bLast.value;
				if (bByService.checked) t += " by service";
				return t;
			}
			function syncFromBuilder() {
				const t = buildDSLText();
				bPreview.textContent = t;
				if (t === view.state.doc.toString()) return;
				view.dispatch({
					changes: { from: 0, to: view.state.doc.length, insert: t },
					effects: placeholderComp.reconfigure(placeholder(NORMAL_PH)),
				});
			}
			function populateBuilder(p) {
				bVerb.value = p.verb;
				bMetric.value = p.metric;
				bFilters.innerHTML = "";
				(p.filters || []).forEach((f) => addFilterRow(f.key, f.value));
				if (p.perMs) { ensureOption(bPer, fmtDur(p.perMs)); } else { bPer.value = ""; }
				// canonicalize one day to the idiomatic "24h" so the round trip
				// doesn't grow a duplicate "1d" option next to it
				ensureOption(bLast, p.lastMs === 86400000 ? "24h" : fmtDur(p.lastMs));
				bByService.checked = !!p.byService;
				bPreview.textContent = view.state.doc.toString();
			}
			function resetBuilder() {
				bVerb.value = "avg";
				bMetric.value = "";
				bFilters.innerHTML = "";
				bPer.value = "";
				bLast.value = "24h";
				bByService.checked = false;
				bPreview.textContent = "";
			}
			function applyMode(mode) {
				localStorage.setItem(MODE_KEY, mode);
				const isBuilder = mode === "builder";
				builder.classList.toggle("hidden", !isBuilder);
				builder.classList.toggle("flex", isBuilder);
				host.classList.toggle("hidden", isBuilder);
				// btn-primary, not btn-active: the active segment must be
				// unmistakable (the one-notch contrast rule)
				modeBuilder.classList.toggle("btn-primary", isBuilder);
				modeText.classList.toggle("btn-primary", !isBuilder);
			}
			modeText.addEventListener("click", () => applyMode("text"));
			modeBuilder.addEventListener("click", () => {
				const t = view.state.doc.toString().trim();
				if (!t) {
					applyMode("builder");
					return;
				}
				// populate from the server's parse; unparseable stays in text
				fetch("/metrics-explorer/compile?dsl=" + encodeURIComponent(t))
					.then((r) => r.json())
					.then((res) => {
						if (!res.parsed) {
							hint.textContent = (res.error || "can't read this expression") + " - fix it (or clear it) to switch to the builder";
							hint.classList.remove("hidden");
							return;
						}
						populateBuilder(res.parsed);
						applyMode("builder");
					})
					.catch(() => {});
			});
			bFilters.addEventListener("click", (e) => {
				if (e.target.closest(".b-fremove")) {
					e.target.closest(".b-filter").remove();
					syncFromBuilder();
				}
			});
			document.getElementById("b-add-filter").addEventListener("click", () => addFilterRow("", ""));
			builder.addEventListener("input", syncFromBuilder);
			builder.addEventListener("change", syncFromBuilder);

			// hand-editing the SQL (or loading a snippet) detaches the whole
			// quick-query pipeline: DSL text cleared, builder reset, the
			// placeholder explains
			function detach() {
				clearTimeout(compileTimer);
				hidden.value = "";
				hint.classList.add("hidden");
				counterHint.classList.add("hidden");
				resetBuilder();
				if (view.state.doc.length) {
					view.dispatch({
						changes: { from: 0, to: view.state.doc.length, insert: "" },
						effects: placeholderComp.reconfigure(placeholder(DETACHED_PH)),
					});
				}
			}
			// detach only on REAL edits to the SQL (the shared module raises
			// pooml:user-edit for user-origin doc changes; clicks, selection,
			// and our own compile dispatches don't count)
			const sqlHost = form.querySelector(".sql-editor-host");
			if (sqlHost) {
				sqlHost.addEventListener("pooml:user-edit", detach);
			}
			// snippet chips with an authored DSL equivalent fill the DSL too -
			// the compile pipeline then normalizes the SQL, and the whole
			// ladder (builder, DSL, SQL) stays in agreement. Chips without one
			// detach the quick query as any hand-edit would.
			document.addEventListener("click", (e) => {
				const chip = e.target.closest("[data-snippet]");
				if (!chip) return;
				if (chip.dataset.dslSnippet) {
					populateBuilderNext = true;
					view.dispatch({
						changes: { from: 0, to: view.state.doc.length, insert: chip.dataset.dslSnippet },
						effects: placeholderComp.reconfigure(placeholder(NORMAL_PH)),
					});
				} else {
					detach();
				}
			});

			new MutationObserver(() => {
				view.dispatch({ effects: themeComp.reconfigure(isLight() ? [] : oneDark) });
			}).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

			// initial mode: remembered choice, builder for first contact; an
			// incoming dsl URL param populates the builder via one parse
			const initialMode = localStorage.getItem(MODE_KEY) || "builder";
			applyMode(initialMode);
			const initial = view.state.doc.toString().trim();
			if (initial && initialMode === "builder") {
				fetch("/metrics-explorer/compile?dsl=" + encodeURIComponent(initial))
					.then((r) => r.json())
					.then((res) => { if (res.parsed) populateBuilder(res.parsed); })
					.catch(() => {});
			}
		}
	</script>
}

// viewSegment: plain GET links, not JS - switching view IS navigation, and
// the URL stays the single source of truth for q + view.
templ viewSegment(v MetricsExplorerView, view string, label string) {
	<a
		href={ templ.SafeURL(metricsViewURL(v.Query, v.DSL, view)) }
		class={ "join-item btn btn-sm", templ.KV("btn-primary", v.View == view) }
	>{ label }</a>
}

// saveAsPanel moves an iterated-into-shape query onto a dashboard without
// retyping: explorer = iterate, dashboards = keep.
templ saveAsPanel(v MetricsExplorerView, csrfToken string) {
	<div class="card bg-base-100">
		<div class="card-body py-3">
			if len(v.Dashboards) == 0 {
				<p class="text-sm opacity-60">
					Like this view? <a href="/dashboards" class="link link-primary">Create a dashboard</a> and you can save queries as panels.
				</p>
			} else {
				<form method="post" action="/metrics-explorer/save-panel" class="flex gap-2 items-end flex-wrap">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<input type="hidden" name="query" value={ v.Query }/>
					<input type="hidden" name="chart_type" value={ v.View }/>
					<span class="text-sm opacity-60 self-center mr-1">Keep this view:</span>
					<label class="flex flex-col gap-1">
						<span class="text-sm opacity-80">Panel title</span>
						<input type="text" name="title" class="input input-bordered input-sm w-48" maxlength="100" required/>
					</label>
					<label class="flex flex-col gap-1">
						<span class="text-sm opacity-80">Dashboard</span>
						<select name="dashboard_id" class="select select-bordered select-sm">
							for _, d := range v.Dashboards {
								<option value={ strconv.FormatInt(d.ID, 10) }>{ d.Name }</option>
							}
						</select>
					</label>
					<button type="submit" class="btn btn-ghost btn-sm">Save as panel</button>
				</form>
			}
		</div>
	</div>
}
